{
  "name": "starter-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "24.22.1",
    "npm": "12.2.0"
  },
  "scripts": {
    "local": "node scripts/run.mjs dev local",
    "build": "node scripts/run.mjs build local",
    "start": "next start --hostname 127.0.0.1",
    "build:local": "node scripts/run.mjs build local",
    "build:dev": "node scripts/run.mjs build dev",
    "build:stg": "node scripts/run.mjs build stg",
    "build:prod": "node scripts/run.mjs build prod",
    "typecheck": "node scripts/run.mjs typecheck local",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:foundation": "node scripts/verify-foundation.mjs",
    "test:auth": "node scripts/verify-auth.mjs",
    "api:gen": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@tanstack/react-query": "5.104.5",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "axios": "1.20.0",
    "decimal.js": "10.6.0",
    "echarts": "6.1.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "orval": "8.45.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}

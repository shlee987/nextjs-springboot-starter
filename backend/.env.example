# local은 bootRunLocal 또는 프로파일 선택만으로 아래 기본값을 사용한다.
# 공개된 가짜 테스트 자격이며 dev/stg/prod에 사용하지 않는다.
# Spring은 이 파일을 자동으로 읽지 않는다. 필요한 값만 환경변수로 override한다.
SPRING_PROFILES_ACTIVE=local
APP_PUBLIC_ORIGIN=http://localhost:3000
DB_URL=jdbc:postgresql://127.0.0.1:25432/starter_local
DB_USERNAME=testuser
DB_PASSWORD=1234
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
REDIS_USERNAME=testuser
REDIS_PASSWORD=1234

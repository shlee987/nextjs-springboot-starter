# 공개 합성 local 기본값. Spring은 이 파일을 자동으로 읽지 않는다.
SPRING_PROFILES_ACTIVE=local
APP_PUBLIC_ORIGIN=http://localhost:3000
DB_URL=jdbc:postgresql://127.0.0.1:25432/starter_local
DB_USERNAME=testuser
DB_PASSWORD=1234
APP_AUTH_STATE_STORE=redis
APP_AUTH_NAMESPACE_GENERATION=v1
APP_AUTH_CONCURRENT_LOGIN=allow
APP_AUTH_PRELOGIN_SESSION_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
REDIS_USERNAME=testuser
REDIS_PASSWORD=1234
# local 기본은 ./.private/files. 공유 환경에서는 웹 루트 밖의 전용 절대 경로를 지정한다.
# Windows 예: APP_FILES_ROOT=C:/starter-private/files
# POSIX 예: APP_FILES_ROOT=/private/starter-files
# 공유 환경의 JWK/JWKS·별도 감사 secret·보존 기간은 README의 외부 필수값을 사용한다.

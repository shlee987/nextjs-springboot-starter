<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="LOG_DIRECTORY" source="app.logging.directory" defaultValue="./logs"/>
    <springProperty name="ENVIRONMENT" source="spring.profiles.active" defaultValue="unset"/>
    <springProperty name="SERVER_ID" source="app.server-id" defaultValue="unset"/>
    <springProperty name="MAX_FILE" source="app.logging.max-file-size" defaultValue="100MB"/>
    <springProperty name="HISTORY" source="app.logging.max-history" defaultValue="30"/>
    <springProperty name="APP_CAP" source="app.logging.application-total-cap" defaultValue="3GB"/>
    <springProperty name="ERROR_CAP" source="app.logging.error-total-cap" defaultValue="1GB"/>
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                <charset>UTF-8</charset>
                <layout class="com.example.starter.common.config.SafeLogLayout"/>
            </encoder>
        </appender>
        <logger name="starter.sql" level="DEBUG"/>
        <root level="INFO"><appender-ref ref="CONSOLE"/></root>
    </springProfile>
    <springProfile name="dev | stg | prod">
        <appender name="APPLICATION" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIRECTORY}/${ENVIRONMENT}/${SERVER_ID}/application.log</file>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter"><level>INFO</level></filter>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIRECTORY}/${ENVIRONMENT}/${SERVER_ID}/application/%d{yyyy-MM-dd,UTC}/application.%i.log.gz</fileNamePattern>
                <maxFileSize>${MAX_FILE}</maxFileSize><maxHistory>${HISTORY}</maxHistory>
                <totalSizeCap>${APP_CAP}</totalSizeCap><cleanHistoryOnStart>true</cleanHistoryOnStart>
            </rollingPolicy>
            <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                <charset>UTF-8</charset><layout class="com.example.starter.common.config.SafeLogLayout"><json>true</json></layout>
            </encoder>
        </appender>
        <appender name="ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIRECTORY}/${ENVIRONMENT}/${SERVER_ID}/error.log</file>
            <filter class="ch.qos.logback.classic.filter.LevelFilter"><level>ERROR</level><onMatch>ACCEPT</onMatch><onMismatch>DENY</onMismatch></filter>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIRECTORY}/${ENVIRONMENT}/${SERVER_ID}/error/%d{yyyy-MM-dd,UTC}/error.%i.log.gz</fileNamePattern>
                <maxFileSize>${MAX_FILE}</maxFileSize><maxHistory>${HISTORY}</maxHistory>
                <totalSizeCap>${ERROR_CAP}</totalSizeCap><cleanHistoryOnStart>true</cleanHistoryOnStart>
            </rollingPolicy>
            <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                <charset>UTF-8</charset><layout class="com.example.starter.common.config.SafeLogLayout"><json>true</json></layout>
            </encoder>
        </appender>
        <root level="INFO"><appender-ref ref="APPLICATION"/><appender-ref ref="ERROR"/></root>
    </springProfile>
</configuration>

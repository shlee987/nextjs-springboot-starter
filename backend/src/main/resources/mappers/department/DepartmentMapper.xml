<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.starter.department.mapper.DepartmentMapper">
    <!-- 잠근 부서가 신규 소속을 받을 수 있는지 확인한다. -->
    <select id="selectActive" resultType="boolean">
        SELECT "ACTIVE" FROM "DEPARTMENT" WHERE "DEPARTMENT_ID" = #{departmentId}
    </select>
    <sql id="searchCondition">
        <where><if test="q != null">D."DEPARTMENT_NAME" ILIKE #{pattern} ESCAPE '\'</if></where>
    </sql>
    <!-- 동일 검색·정렬 계약으로 부서 페이지를 읽는다. -->
    <select id="selectDepartmentList" resultType="com.example.starter.department.model.DepartmentSummary">
        SELECT D."DEPARTMENT_ID"::text AS "DEPARTMENT_ID", D."DEPARTMENT_CODE", D."DEPARTMENT_NAME"
            , D."PARENT_ID"::text AS "PARENT_ID", D."SORT_ORDER", D."ACTIVE"
        FROM "DEPARTMENT" D <include refid="searchCondition"/>
        ORDER BY <choose>
            <when test="sort.name() == 'nameAsc'">D."DEPARTMENT_NAME" ASC,</when>
            <when test="sort.name() == 'nameDesc'">D."DEPARTMENT_NAME" DESC,</when>
        </choose> D."DEPARTMENT_ID" ASC
        LIMIT #{size} OFFSET #{offset}
    </select>
    <!-- 목록과 같은 검색 조건의 건수다. -->
    <select id="selectDepartmentCount" resultType="long">
        SELECT count(*) FROM "DEPARTMENT" D <include refid="searchCondition"/>
    </select>
    <!-- 조상 변경 경쟁을 막기 위해 부서 계층을 ID 순서로 잠근다. -->
    <select id="selectDepartmentListForUpdate" resultType="long">
        SELECT "DEPARTMENT_ID" FROM "DEPARTMENT" ORDER BY "DEPARTMENT_ID" FOR UPDATE
    </select>
    <!-- 현재 계층에서 부모 방향의 조상 ID를 읽는다. -->
    <select id="selectAncestorList" resultType="long">
        WITH RECURSIVE ANCESTOR AS (
            SELECT "DEPARTMENT_ID", "PARENT_ID" FROM "DEPARTMENT" WHERE "DEPARTMENT_ID" = #{departmentId}
            UNION
            SELECT D."DEPARTMENT_ID", D."PARENT_ID" FROM "DEPARTMENT" D
            JOIN ANCESTOR A ON A."PARENT_ID" = D."DEPARTMENT_ID"
        ) SELECT "DEPARTMENT_ID" FROM ANCESTOR
    </select>
    <!-- version 조건으로 새 부모를 연결한다. -->
    <update id="updateParent">
        UPDATE "DEPARTMENT" SET "PARENT_ID" = #{parentId,jdbcType=BIGINT}, "UPDATED_AT" = #{now}
            , "UPDATED_BY" = #{actor,jdbcType=BIGINT}, "VERSION" = "VERSION" + 1
        WHERE "DEPARTMENT_ID" = #{departmentId} AND "VERSION" = #{version}
    </update>
</mapper>
